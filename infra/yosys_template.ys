# AutoSilicon — Yosys Synthesis Template (Sky130)
# Placeholders (replaced by synth_sweep.py):
#   DESIGN_TOP, RTL_FILES, PARAM_LIST, JSON_OUT, NETLIST_OUT, LIBERTY_FILE

# ── Read RTL ──────────────────────────────────────────────────
__RTL_FILES__

# ── Set parameters ────────────────────────────────────────────
__PARAM_LIST__

# ── Synthesize ────────────────────────────────────────────────
synth -top __DESIGN_TOP__ -flatten

# ── Map to Sky130 cells ───────────────────────────────────────
dfflibmap -liberty __LIBERTY_FILE__
abc -liberty __LIBERTY_FILE__ -D 20000 -script __ABC_SCRIPT__

# ── Statistics (with area from liberty) ───────────────────────
stat -liberty __LIBERTY_FILE__
tee -o __JSON_OUT__ stat -json -liberty __LIBERTY_FILE__

# ── Write gate-level netlist ──────────────────────────────────
write_verilog -noattr __NETLIST_OUT__
