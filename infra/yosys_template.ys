# AutoSilicon — Generic Yosys Synthesis Template
# ================================================
# Parameterized by infra/synth_sweep.py. Placeholders are replaced
# per synthesis configuration.
#
# Placeholders (replaced by synth_sweep.py):
#   DESIGN_TOP, RTL_FILES, PARAM_LIST, JSON_OUT, NETLIST_OUT

# ── Read RTL ──────────────────────────────────────────────────
# Package file must be first (contains type/parameter definitions).
# These lines are generated by synth_sweep.py from the design's config.
__RTL_FILES__

# ── Set parameters ────────────────────────────────────────────
# chparam lines generated by synth_sweep.py for this configuration.
__PARAM_LIST__

# ── Generic synthesis ─────────────────────────────────────────
synth -top __DESIGN_TOP__ -flatten

# ── Statistics (generic) ──────────────────────────────────────
stat
tee -o __JSON_OUT__ stat -json

# ── Write gate-level netlist ──────────────────────────────────
write_verilog -noattr __NETLIST_OUT__

# ── Sky130 targeted synthesis (optional) ──────────────────────
# If a Sky130 liberty file is available, run ABC with it for
# realistic area estimates. Uncomment or use the sky130 variant:
#
# read_liberty __LIBERTY_FILE__
# abc -liberty __LIBERTY_FILE__
# stat -liberty __LIBERTY_FILE__
